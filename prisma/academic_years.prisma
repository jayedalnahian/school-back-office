model academic_years {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id           String                @db.Uuid
  year                Int
  start_date          DateTime              @db.Date
  end_date            DateTime              @db.Date
  is_current          Boolean?              @default(false)
  is_deleted          Boolean?              @default(false)
  deleted_at          DateTime?             @db.Timestamptz(6)
  created_by          String?               @db.Uuid
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  users               users?                @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  schools             School                @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attendances         attendances[]
  class_routines      class_routines[]
  enrollments         enrollments[]
  student_evaluations student_evaluations[]

  @@unique([school_id, year], map: "uq_school_academic_year")
  @@index([is_deleted], map: "idx_academic_years_is_deleted")
  @@index([school_id, is_current], map: "idx_academic_years_school_current")
}
