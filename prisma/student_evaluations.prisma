model student_evaluations {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  student_id            String                @db.Uuid
  indicator_id          String                @db.Uuid
  teacher_id            String                @db.Uuid
  academic_year_id      String                @db.Uuid
  level                 assessment_level
  evaluation_date       DateTime?             @default(now()) @db.Timestamptz(6)
  remarks               String?
  is_deleted            Boolean?              @default(false)
  deleted_at            DateTime?             @db.Timestamptz(6)
  created_by            String?               @db.Uuid
  created_at            DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?             @default(now()) @db.Timestamptz(6)
  academic_years        academic_years        @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?                @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  evaluation_indicators evaluation_indicators @relation(fields: [indicator_id], references: [id], onUpdate: NoAction)
  students              students              @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teacher_profiles      teacher_profiles      @relation(fields: [teacher_id], references: [id], onUpdate: NoAction)

  @@index([indicator_id], map: "idx_evaluations_indicator_id")
  @@index([is_deleted], map: "idx_evaluations_is_deleted")
  @@index([student_id, academic_year_id], map: "idx_evaluations_student_year")
}
