model classes {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id   String     @db.Uuid
  name        String     @db.VarChar(50)
  grade_level Int
  is_deleted  Boolean?   @default(false)
  deleted_at  DateTime?  @db.Timestamptz(6)
  created_by  String?    @db.Uuid
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @default(now()) @db.Timestamptz(6)
  users       users?     @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  schools     School     @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sections    sections[]
  subjects    subjects[]

  @@unique([school_id, grade_level], map: "uq_school_grade_level")
  @@index([is_deleted], map: "idx_classes_is_deleted")
  @@index([school_id], map: "idx_classes_school_id")
}
