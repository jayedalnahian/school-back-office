model subjects {
  id                    String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id             String                  @db.Uuid
  class_id              String                  @db.Uuid
  name                  String                  @db.VarChar(100)
  code                  String?                 @db.VarChar(20)
  is_deleted            Boolean?                @default(false)
  deleted_at            DateTime?               @db.Timestamptz(6)
  created_by            String?                 @db.Uuid
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  class_routines        class_routines[]
  evaluation_indicators evaluation_indicators[]
  classes               classes                 @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?                  @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  schools               School                  @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([class_id, name], map: "uq_class_subject_name")
  @@index([class_id], map: "idx_subjects_class_id")
  @@index([is_deleted], map: "idx_subjects_is_deleted")
  @@index([school_id], map: "idx_subjects_school_id")
}
