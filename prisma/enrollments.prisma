model enrollments {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  student_id       String         @db.Uuid
  academic_year_id String         @db.Uuid
  section_id       String         @db.Uuid
  roll_number      Int
  is_deleted       Boolean?       @default(false)
  deleted_at       DateTime?      @db.Timestamptz(6)
  created_by       String?        @db.Uuid
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?      @default(now()) @db.Timestamptz(6)
  academic_years   academic_years @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?         @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  sections         sections       @relation(fields: [section_id], references: [id], onUpdate: NoAction)
  students         students       @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([academic_year_id, section_id, roll_number], map: "uq_year_section_roll")
  @@unique([academic_year_id, student_id], map: "uq_year_student")
  @@index([is_deleted], map: "idx_enrollments_is_deleted")
  @@index([student_id], map: "idx_enrollments_student_id")
  @@index([academic_year_id, section_id], map: "idx_enrollments_year_section")
}
