model teacher_profiles {
  id                                       String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                                  String                @unique @db.Uuid
  school_id                                String                @db.Uuid
  designation                              String                @db.VarChar(100)
  qualification                            String?               @db.VarChar(255)
  joined_date                              DateTime?             @db.Date
  gender                                   gender?
  is_active                                Boolean?              @default(true)
  is_deleted                               Boolean?              @default(false)
  deleted_at                               DateTime?             @db.Timestamptz(6)
  created_by                               String?               @db.Uuid
  created_at                               DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime?             @default(now()) @db.Timestamptz(6)
  class_routines                           class_routines[]
  sections                                 sections[]
  student_evaluations                      student_evaluations[]
  users_teacher_profiles_created_byTousers users?                @relation("teacher_profiles_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  schools                                  School                @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_teacher_profiles_user_idTousers    users                 @relation("teacher_profiles_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_deleted], map: "idx_teacher_profiles_is_deleted")
  @@index([school_id, is_active], map: "idx_teacher_profiles_school_active")
}
