model sections {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  class_id         String            @db.Uuid
  shift_id         String            @db.Uuid
  name             String            @db.VarChar(50)
  class_teacher_id String?           @db.Uuid
  is_deleted       Boolean?          @default(false)
  deleted_at       DateTime?         @db.Timestamptz(6)
  created_by       String?           @db.Uuid
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?         @default(now()) @db.Timestamptz(6)
  class_routines   class_routines[]
  enrollments      enrollments[]
  classes          classes           @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teacher_profiles teacher_profiles? @relation(fields: [class_teacher_id], references: [id], onUpdate: NoAction)
  users            users?            @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  shifts           shifts            @relation(fields: [shift_id], references: [id], onUpdate: NoAction)

  @@unique([class_id, shift_id, name], map: "uq_class_shift_section")
  @@index([class_id], map: "idx_sections_class_id")
  @@index([is_deleted], map: "idx_sections_is_deleted")
  @@index([shift_id], map: "idx_sections_shift_id")
}
