model guardian_profiles {
  id                                        String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                                   String     @unique @db.Uuid
  relation_type                             String     @db.VarChar(50)
  nid_number                                String?    @db.VarChar(30)
  is_deleted                                Boolean?   @default(false)
  deleted_at                                DateTime?  @db.Timestamptz(6)
  created_by                                String?    @db.Uuid
  created_at                                DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime?  @default(now()) @db.Timestamptz(6)
  users_guardian_profiles_created_byTousers users?     @relation("guardian_profiles_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  users_guardian_profiles_user_idTousers    users      @relation("guardian_profiles_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  students                                  students[]

  @@index([is_deleted], map: "idx_guardian_profiles_is_deleted")
  @@index([user_id], map: "idx_guardian_profiles_user_id")
}
